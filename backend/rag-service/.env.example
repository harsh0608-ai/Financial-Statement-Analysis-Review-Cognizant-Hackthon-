# ── RAG Service Configuration ─────────────────────────────────
# No mandatory API keys. The service runs fully locally.

# Embedding model (sentence-transformers hub name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector store persistence path
VECTOR_STORE_PATH=./data/vector_store

# Knowledge base source directory
KNOWLEDGE_BASE_DIR=./knowledge_base/wp514

# Chunking parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval parameters
TOP_K=5
SIMILARITY_THRESHOLD=0.25

# Server
RAG_HOST=0.0.0.0
RAG_PORT=8001

# ChromaDB collection
COLLECTION_NAME=wp514_knowledge
